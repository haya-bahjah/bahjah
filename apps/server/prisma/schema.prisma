generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  fullName       String
  email          String   @unique
  countryCode    String
  phone          String
  dob            DateTime
  passwordHash   String
  marketingOptIn Boolean  @default(false)
  // Either "icon:<id>" (one of the built-in avatar icons) or a data: URL for
  // an uploaded photo, already resized/compressed client-side. Null means
  // "use the deterministic default icon derived from the user id."
  avatar         String?
  createdAt      DateTime @default(now())

  hostedRooms Room[]       @relation("RoomHost")
  memberships RoomMember[]
}

enum GameType {
  trivia
  mafia
  knows_you_best
}

enum RoomStatus {
  lobby
  in_progress
  ended
}

model Room {
  id        String     @id @default(uuid())
  code      String     @unique
  gameType  GameType
  status    RoomStatus @default(lobby)
  hostId    String
  host      User       @relation("RoomHost", fields: [hostId], references: [id])
  createdAt DateTime   @default(now())
  endedAt   DateTime?

  members RoomMember[]
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  room     Room     @relation(fields: [roomId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  isHost   Boolean  @default(false)
  isReady  Boolean  @default(false)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

enum TriviaDifficulty {
  easy
  medium
  hard
}

model TriviaQuestion {
  id           String           @id @default(uuid())
  category     String
  difficulty   TriviaDifficulty @default(medium)
  prompt       String
  choices      String[]
  correctIndex Int
  createdAt    DateTime         @default(now())
}

// Host-authored questions for a custom category, scoped to the room that
// created them. Not part of the shared TriviaQuestion bank -- only ever
// read back for the room they were created in.
model TriviaCustomQuestion {
  id           String   @id @default(uuid())
  roomCode     String
  category     String
  prompt       String
  choices      String[]
  correctIndex Int
  createdAt    DateTime @default(now())

  @@index([roomCode])
}

model KnowsYouBestPrompt {
  id        String   @id @default(uuid())
  category  String
  text      String
  createdAt DateTime @default(now())
}
