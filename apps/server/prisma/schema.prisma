generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  fullName       String
  email          String?   @unique
  countryCode    String?
  phone          String?
  dob            DateTime?
  passwordHash   String?
  // Guest accounts (join-by-nickname, no signup) never have email/phone/dob/
  // passwordHash -- only fullName (their nickname) and optionally avatar.
  isGuest        Boolean   @default(false)
  marketingOptIn Boolean   @default(false)
  // Either "icon:<id>" (one of the built-in avatar icons) or a data: URL for
  // an uploaded photo, already resized/compressed client-side. Null means
  // "use the deterministic default icon derived from the user id."
  avatar         String?
  createdAt      DateTime  @default(now())

  hostedRooms Room[]            @relation("RoomHost")
  memberships RoomMember[]
  gameHistory GameHistoryEntry[]
}

enum GameType {
  trivia
  mafia
  knows_you_best
}

enum RoomStatus {
  lobby
  in_progress
  ended
}

model Room {
  id        String     @id @default(uuid())
  code      String     @unique
  gameType  GameType
  status    RoomStatus @default(lobby)
  hostId    String
  host      User       @relation("RoomHost", fields: [hostId], references: [id])
  createdAt DateTime   @default(now())
  endedAt   DateTime?

  members RoomMember[]
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  room     Room     @relation(fields: [roomId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  isHost   Boolean  @default(false)
  isReady  Boolean  @default(false)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

enum TriviaDifficulty {
  easy
  medium
  hard
}

model TriviaQuestion {
  id           String           @id @default(uuid())
  category     String
  difficulty   TriviaDifficulty @default(medium)
  prompt       String
  promptAr     String?
  choices      String[]
  choicesAr    String[]         @default([])
  correctIndex Int
  createdAt    DateTime         @default(now())
}

// Host-authored questions for a custom category, scoped to the room that
// created them. Not part of the shared TriviaQuestion bank -- only ever
// read back for the room they were created in.
model TriviaCustomQuestion {
  id           String   @id @default(uuid())
  roomCode     String
  category     String
  prompt       String
  choices      String[]
  correctIndex Int
  createdAt    DateTime @default(now())

  @@index([roomCode])
}

model KnowsYouBestPrompt {
  id        String   @id @default(uuid())
  category  String
  text      String
  textAr    String?
  createdAt DateTime @default(now())
}

// Host-authored questions for a room, free-text only (no choices/correctIndex
// -- KYB answers are free text, unlike trivia's multiple choice). Not part of
// the shared KnowsYouBestPrompt bank -- only ever read back for the room that
// created them, same lifecycle as TriviaCustomQuestion.
model KnowsYouBestCustomPrompt {
  id        String   @id @default(uuid())
  roomCode  String
  text      String
  textAr    String?
  createdAt DateTime @default(now())

  @@index([roomCode])
}

// Written once, right when a game naturally resolves into its 'finished'
// phase (see games/history.ts) -- never for a room a host manually ends
// mid-game. roomCode/results are snapshotted rather than foreign-keyed so a
// history entry stays meaningful even if the Room row or player display
// names change later.
model GameHistoryEntry {
  id       String   @id @default(uuid())
  roomCode String
  gameType GameType
  hostId   String
  host     User     @relation(fields: [hostId], references: [id])
  playedAt DateTime @default(now())
  results  Json // Array<{ userId: string; displayName: string; score: number; isWinner: boolean }>

  @@index([hostId])
}
