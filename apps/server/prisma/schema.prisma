generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  fullName       String
  email          String?   @unique
  countryCode    String?
  phone          String?
  dob            DateTime?
  passwordHash   String?
  // Guest accounts (join-by-nickname, no signup) never have email/phone/dob/
  // passwordHash -- only fullName (their nickname) and optionally avatar.
  isGuest        Boolean   @default(false)
  marketingOptIn Boolean   @default(false)
  // Either "icon:<id>" (one of the built-in avatar icons) or a data: URL for
  // an uploaded photo, already resized/compressed client-side. Null means
  // "use the deterministic default icon derived from the user id."
  avatar         String?
  createdAt      DateTime  @default(now())

  // Billing. The 6-hour free trial itself is not a stored field -- it's
  // always "createdAt + 6h", computed in payments/access.ts. These fields
  // only track paid access beyond that trial window.
  plan               BillingPlan        @default(none)
  subscriptionStatus SubscriptionStatus @default(none)
  // Access is granted through this instant regardless of plan/subscription
  // state -- sufficient on its own for a Day Pass, and kept in sync with
  // nextBillingAt for an active Monthly subscription.
  paidUntil          DateTime?
  nextBillingAt      DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  renewalAttempts    Int                @default(0)
  // Saved card token from Moyasar, used to charge Monthly renewals without
  // the user re-entering card details. cardBrand/cardLast4 are display-only
  // (Settings "manage payment method"), never enough to charge on their own.
  cardToken          String?
  cardBrand          String?
  cardLast4          String?

  hostedRooms   Room[]            @relation("RoomHost")
  memberships   RoomMember[]
  gameHistory   GameHistoryEntry[]
  payments      Payment[]
  pinnedGames   PinnedGame[]
  questionPacks QuestionPack[]
}

enum BillingPlan {
  none
  day_pass
  monthly
}

enum SubscriptionStatus {
  none
  active
  past_due
  canceled
}

// One row per Moyasar payment attempt (initial purchase or a monthly
// renewal charge), keyed by Moyasar's own payment id so webhook delivery
// is naturally idempotent -- a retried webhook for the same payment just
// updates the same row instead of creating a duplicate.
model Payment {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  moyasarId String      @unique
  plan      BillingPlan
  // Minor currency units (halalas for SAR), matching what's sent to Moyasar.
  amount    Int
  currency  String      @default("SAR")
  // Mirrors Moyasar's payment status string verbatim (initiated, paid,
  // failed, authorized, captured, refunded, voided) rather than an enum,
  // since Moyasar can add statuses we don't want a migration to react to.
  status    String
  kind      String // "purchase" | "renewal"
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

enum GameType {
  trivia
  mafia
  knows_you_best
}

enum RoomStatus {
  lobby
  in_progress
  ended
}

model Room {
  id        String     @id @default(uuid())
  code      String     @unique
  gameType  GameType
  status    RoomStatus @default(lobby)
  hostId    String
  host      User       @relation("RoomHost", fields: [hostId], references: [id])
  createdAt DateTime   @default(now())
  endedAt   DateTime?

  members RoomMember[]
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  room     Room     @relation(fields: [roomId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  isHost   Boolean  @default(false)
  isReady  Boolean  @default(false)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

enum TriviaDifficulty {
  easy
  medium
  hard
}

model TriviaQuestion {
  id           String           @id @default(uuid())
  category     String
  difficulty   TriviaDifficulty @default(medium)
  prompt       String
  promptAr     String?
  choices      String[]
  choicesAr    String[]         @default([])
  correctIndex Int
  createdAt    DateTime         @default(now())
}

// Host-authored questions for a custom category, scoped to the room that
// created them. Not part of the shared TriviaQuestion bank -- only ever
// read back for the room they were created in.
model TriviaCustomQuestion {
  id           String   @id @default(uuid())
  roomCode     String
  category     String
  prompt       String
  choices      String[]
  correctIndex Int
  createdAt    DateTime @default(now())

  @@index([roomCode])
}

model KnowsYouBestPrompt {
  id        String   @id @default(uuid())
  category  String
  text      String
  textAr    String?
  createdAt DateTime @default(now())
}

// Host-authored questions for a room, free-text only (no choices/correctIndex
// -- KYB answers are free text, unlike trivia's multiple choice). Not part of
// the shared KnowsYouBestPrompt bank -- only ever read back for the room that
// created them, same lifecycle as TriviaCustomQuestion.
model KnowsYouBestCustomPrompt {
  id        String   @id @default(uuid())
  roomCode  String
  text      String
  textAr    String?
  createdAt DateTime @default(now())

  @@index([roomCode])
}

// Written once, right when a game naturally resolves into its 'finished'
// phase (see games/history.ts) -- never for a room a host manually ends
// mid-game. roomCode/results are snapshotted rather than foreign-keyed so a
// history entry stays meaningful even if the Room row or player display
// names change later.
model GameHistoryEntry {
  id       String   @id @default(uuid())
  roomCode String
  gameType GameType
  hostId   String
  host     User     @relation(fields: [hostId], references: [id])
  playedAt DateTime @default(now())
  results  Json // Array<{ userId: string; displayName: string; score: number; isWinner: boolean }>

  @@index([hostId])
}

// A user's manually-chosen shortcuts for the signed-in landing page's
// "Pinned Games" row. One row per (user, gameType) they've pinned -- max 3
// possible (one per GameType) since pinning is a toggle, not a list.
model PinnedGame {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  gameType  GameType
  createdAt DateTime @default(now())

  @@unique([userId, gameType])
}

// A named, reusable set of custom questions/prompts a user has saved from
// the "My Games" section, independent of any one room's lifecycle (unlike
// TriviaCustomQuestion/KnowsYouBestCustomPrompt, which are deleted with the
// room they were typed into). Only trivia and knows-you-best support custom
// questions today, so gameType is never 'mafia' here.
// items shape by gameType:
//   trivia:          Array<{ prompt: string; choices: [string,string,string,string]; correctIndex: number }>
//   knows-you-best:  Array<{ text: string; textAr?: string | null }>
model QuestionPack {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  gameType  GameType
  name      String
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
