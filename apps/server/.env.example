PORT=3001
DATABASE_URL=postgresql://bahjah:bahjah@localhost:5432/bahjah
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-fly-secrets
WEB_ORIGIN=http://localhost:5173
# Optional -- the server boots fine without these, payments just respond
# with a clean "not configured yet" error until they're set.
MOYASAR_SECRET_KEY=change-me-in-fly-secrets
MOYASAR_PUBLISHABLE_KEY=change-me-in-fly-secrets
MOYASAR_WEBHOOK_SECRET=change-me-in-fly-secrets
# Optional -- comma-separated emails exempt from the 6-hour trial and from
# paid access, so QA accounts stay open indefinitely. Defaults to
# latifa@bahjah.com; set it to an empty string to turn the exemption off.
TEST_ACCOUNT_EMAILS=latifa@bahjah.com
# Optional -- the contact form. Without these the server still boots and the
# form answers with a clean "couldn't send" that points at the inbox address.
# RESEND_API_KEY comes from resend.com; MAIL_FROM must be on a domain verified
# there, or Resend refuses the send. CONTACT_INBOX is where messages land and
# defaults to contact@bahjah.com.
RESEND_API_KEY=change-me-in-fly-secrets
MAIL_FROM=Bahjah <noreply@bahjah.com>
CONTACT_INBOX=contact@bahjah.com
